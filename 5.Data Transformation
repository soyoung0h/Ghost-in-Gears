-- Set role
USE ROLE sysadmin;

-- Set context for investigation database
USE DATABASE investigation;
USE SCHEMA public;

-- Create stage to access new data
CREATE STAGE IF NOT EXISTS investigation5921
  URL = 's3://investigation-5921/';

-- List files and properties of files in staging
LIST @investigation5921;

-- Query and explore city officials file
SELECT official_id AS official_id
FROM city_officials;

-- Clear existing city_officials table
TRUNCATE TABLE city_officials;

-- Reload table
COPY INTO city_officials
  FROM '@investigation2134/city_officials'
  FILE_FORMAT = (FORMAT_NAME = ghosts_csv);

-- Validate load
SELECT COUNT(*) AS num_officials
FROM city_officials;

-- Transform office locations
UPDATE city_officials
SET office_location = CASE office_location
    WHEN 'Building 1' THEN 'Cultural'
    WHEN 'Building 2' THEN 'Downtown'
    WHEN 'Building 3' THEN 'Eastside'
    WHEN 'Building 4' THEN 'Harbor'
    WHEN 'Building 5' THEN 'Midtown'
    WHEN 'Building 6' THEN 'Riverside'
    WHEN 'Building 7' THEN 'Tech Hub'
    WHEN 'Building 8' THEN 'West End'
    ELSE office_location
END;

-- Query entire table
SELECT * FROM city_officials;

-- Add caller names
CREATE OR REPLACE VIEW calls_to_victims AS
SELECT vd.victim_name AS victim_name,
       pd.name AS caller_name,
       c.caller_id AS caller_id,
       c.call_id AS unique_id,
       c.call_start_date AS call_date,
       c.call_status AS call_status,
       vd.directory_id AS directory_id
FROM call_log c
JOIN victim_detail_views vd ON c.receiver_id = vd.directory_id
JOIN phone_directory pd ON pd.directory_id = c.caller_id;

-- Query view
SELECT * FROM calls_to_victims
ORDER BY victim_name ASC, call_date DESC;

-- Calls from city officials
-- (matched by name since city_officials has no directory_id)
SELECT cv.caller_name AS caller_name,
       cv.victim_name AS victim_name,
       cv.directory_id AS directory_id,
       pd.phone_number AS phone_id
FROM phone_directory pd
JOIN calls_to_victims cv ON pd.directory_id = cv.directory_id
JOIN city_officials co ON co.name = cv.caller_name;
